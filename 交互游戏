<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI手势粒子交互系统</title>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/handpose"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body { margin: 0; overflow: hidden; background: #000; font-family: 'Microsoft YaHei', sans-serif; color: white; }
        #container { position: relative; width: 100vw; height: 100vh; }
        
        /* 5.1 & 5.3 UI Panel */
        #ui-panel {
            position: absolute; right: 20px; top: 20px; width: 260px;
            background: rgba(0, 0, 0, 0.7); padding: 15px; border-radius: 12px;
            backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);
            z-index: 100;
        }
        /* 5.2 Status Text */
        #status-display {
            position: absolute; left: 20px; top: 20px; font-size: 18px; line-height: 1.6;
            text-shadow: 0 0 10px rgba(0,255,255,0.8); z-index: 100;
        }
        .control-group { margin-bottom: 15px; }
        label { display: block; font-size: 12px; margin-bottom: 5px; color: #aaa; }
        select, button {
            width: 100%; padding: 8px; background: #333; color: white;
            border: none; border-radius: 4px; cursor: pointer;
        }
        .meter {
            width: 100%; height: 8px; background: #222; border-radius: 4px;
            overflow: hidden; margin-top: 5px;
        }
        .meter-fill { height: 100%; width: 0%; background: #00f2fe; transition: width 0.1s; }
        
        video {
            position: absolute; bottom: 20px; left: 20px; width: 160px;
            height: 120px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);
            transform: scaleX(-1);
            opacity: 0.5;
        }
        canvas#three-canvas { width: 100%; height: 100%; display: block; }
    </style>
</head>
<body>

<div id="container">
    <div id="status-display">
        <div>手型: <span id="current-gesture">初始化中...</span></div>
        <div>运动方向: <span id="current-motion">静止</span></div>
    </div>

    <div id="ui-panel">
        <button id="fullscreen-btn" onclick="toggleFullscreen()">进入全屏</button>
        <div class="control-group" style="margin-top:15px">
            <label>当前形态 (3.1 联动)</label>
            <select id="shape-select">
                <option value="sphere">Sphere (握拳)</option>
                <option value="torus">Torus (手掌)</option>
                <option value="snowflake">雪花 (剪刀手)</option>
                <option value="spiral">螺旋 (鹰爪)</option>
                <option value="stardust">星尘 (OK)</option>
                <option value="random">随机 (竖食指)</option>
            </select>
        </div>
        <div class="control-group">
            <label>颜色模式 (2.2)</label>
            <select id="color-mode">
                <option value="speed">速度映射 (冷暖色)</option>
                <option value="hsl">HSL 循环渐变</option>
                <option value="picker">单色拾取器</option>
            </select>
            <input type="color" id="color-picker" value="#00f2fe" style="margin-top:5px; width:100%">
        </div>
        <div class="control-group">
            <label>幅度 (1.3/3.3): <span id="amp-val">0</span>%</label>
            <div class="meter"><div id="amp-meter" class="meter-fill"></div></div>
        </div>
        <div class="control-group">
            <label>速度 (1.4/3.4): <span id="speed-val">0</span> ms</label>
            <div class="meter"><div id="speed-meter" class="meter-fill"></div></div>
        </div>
    </div>

    <video id="webcam" autoplay playsinline></video>
    <canvas id="three-canvas"></canvas>
</div>

<script>
/** * 核心配置与状态 
 */
const state = {
    gesture: 'None',
    motion: 'Static',
    amplitude: 0, 
    speed: 0, 
    particleCount: 15000, // 4.2 性能指标
    currentShape: 'sphere',
    colorMode: 'speed',
    motionMode: 'none',
    handHistory: [],
    lastPositions: [],
    appId: 'gesture-particle-system'
};

/** * 1. 初始化 Three.js 粒子引擎 
 */
let scene, camera, renderer, particles, particlePositions, targetPositions;
const clock = new THREE.Clock();

function initThree() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 1, 3000);
    camera.position.z = 1000;

    renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('three-canvas'), antialias: false }); // 4.2 为了性能关闭高级抗锯齿
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(state.particleCount * 3);
    const colors = new Float32Array(state.particleCount * 3);
    
    // 2.4 初始形状：AI李探长 文字点阵
    targetPositions = createTextPoints("AI李探长", state.particleCount);
    for(let i=0; i<state.particleCount*3; i++) positions[i] = targetPositions[i];

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
        size: 2.5,
        vertexColors: true,
        transparent: true,
        opacity: 0.8,
        blending: THREE.AdditiveBlending,
        depthWrite: false
    });

    particles = new THREE.Points(geometry, material);
    scene.add(particles);
    particlePositions = positions;
}

/** * 2. 点阵生成逻辑 
 */
function createTextPoints(text, count) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = 1200; canvas.height = 400;
    ctx.fillStyle = 'white';
    ctx.font = 'bold 180px "Microsoft YaHei"'; // 2.4 微软雅黑加粗
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, 600, 200);

    const imageData = ctx.getImageData(0, 0, 1200, 400);
    const pixels = [];
    for (let y = 0; y < 400; y += 2) {
        for (let x = 0; x < 1200; x += 2) {
            if (imageData.data[(y * 1200 + x) * 4] > 128) {
                pixels.push({ x: (x - 600) * 1.8, y: (200 - y) * 1.8 });
            }
        }
    }

    const pos = new Float32Array(count * 3);
    for (let i = 0; i < count; i++) {
        const p = pixels[Math.floor(Math.random() * pixels.length)];
        pos[i * 3] = p ? p.x : 0;
        pos[i * 3 + 1] = p ? p.y : 0;
        pos[i * 3 + 2] = (Math.random() - 0.5) * 50;
    }
    return pos;
}

// 2.1 形态生成 (3.1 & 3.3 联动)
function generateShape(type) {
    const pos = new Float32Array(state.particleCount * 3);
    // 3.3 幅度 -> 粒子范围：小 0-300px，大 300-800px
    const baseRadius = state.amplitude < 0.4 ? (state.amplitude * 750) : (300 + (state.amplitude - 0.4) * 833);
    const radius = Math.max(50, baseRadius); 
    
    for (let i = 0; i < state.particleCount; i++) {
        let x, y, z;
        const idx = i * 3;
        const u = Math.random();
        const v = Math.random();

        switch (type) {
            case 'sphere':
                const phi = Math.acos(2 * u - 1);
                const theta = 2 * Math.PI * v;
                x = radius * Math.sin(phi) * Math.cos(theta);
                y = radius * Math.sin(phi) * Math.sin(theta);
                z = radius * Math.cos(phi);
                break;
            case 'torus':
                const tr = radius * 0.7;
                const pr = radius * 0.3;
                const ta = u * Math.PI * 2;
                const pa = v * Math.PI * 2;
                x = (tr + pr * Math.cos(pa)) * Math.cos(ta);
                y = (tr + pr * Math.cos(pa)) * Math.sin(ta);
                z = pr * Math.sin(pa);
                break;
            case 'snowflake':
                const armAngle = (Math.floor(Math.random() * 6) / 6) * Math.PI * 2;
                const dist = Math.random() * radius;
                x = Math.cos(armAngle) * dist + (Math.random()-0.5) * radius * 0.1;
                y = Math.sin(armAngle) * dist + (Math.random()-0.5) * radius * 0.1;
                z = (Math.random() - 0.5) * radius * 0.2;
                break;
            case 'spiral':
                const angle = i * 0.1;
                const r = (i / state.particleCount) * radius;
                x = Math.cos(angle) * r;
                y = Math.sin(angle) * r;
                z = (i / state.particleCount) * radius - radius/2;
                break;
            case 'stardust':
            default:
                x = (Math.random() - 0.5) * radius * 2;
                y = (Math.random() - 0.5) * radius * 2;
                z = (Math.random() - 0.5) * radius * 2;
                break;
        }
        pos[idx] = x; pos[idx+1] = y; pos[idx+2] = z;
    }
    return pos;
}

/** * 3. 手势检测与联动规则 (指标 1, 3) 
 */
async function initHandPose() {
    const video = document.getElementById('webcam');
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
    } catch(e) {
        document.getElementById('current-gesture').innerText = "未检测到摄像头";
        return;
    }

    const model = await handpose.load();
    console.log("HandPose Loaded");
    
    const detect = async () => {
        const predictions = await model.estimateHands(video);
        if (predictions.length > 0) {
            processHand(predictions[0]);
        } else {
            state.gesture = "None";
            updateStatusUI();
        }
        requestAnimationFrame(detect);
    };
    detect();
}

function processHand(hand) {
    const landmarks = hand.landmarks;
    
    // 1.1 静态手型：握拳、手掌、剪刀手、鹰爪、OK、竖食指
    const palm = landmarks[0];
    const fingerTips = [8, 12, 16, 20];
    const fingersExtended = fingerTips.map(idx => {
        const dist = Math.hypot(landmarks[idx][0] - palm[0], landmarks[idx][1] - palm[1]);
        return dist > 130;
    });
    const thumbDist = Math.hypot(landmarks[4][0] - landmarks[17][0], landmarks[4][1] - landmarks[17][1]);
    const thumbExtended = thumbDist > 100;

    let g = "None";
    const count = fingersExtended.filter(f => f).length;

    if (count === 0 && !thumbExtended) g = "握拳";
    else if (count >= 4 && thumbExtended) g = "手掌";
    else if (count === 2 && fingersExtended[0] && fingersExtended[1]) g = "剪刀手";
    else if (count === 4 && !thumbExtended) g = "鹰爪";
    else if (count === 3 && !fingersExtended[0]) g = "OK";
    else if (count === 1 && fingersExtended[0]) g = "竖食指";

    if (g !== state.gesture && g !== "None") {
        state.gesture = g;
        applyGestureToShape(g);
    }

    // 1.2 运动方向：左右扫、上下扫、前后推
    const currentPos = landmarks[9]; // 中指根部作为中心点
    const now = Date.now();
    state.handHistory.push({ x: currentPos[0], y: currentPos[1], z: currentPos[2], t: now });
    if (state.handHistory.length > 15) state.handHistory.shift();

    if (state.handHistory.length > 5) {
        const first = state.handHistory[0];
        const last = state.handHistory[state.handHistory.length - 1];
        const dx = last.x - first.x;
        const dy = last.y - first.y;
        const dz = last.z - first.z;
        const dt = last.t - first.t;

        // 方向判断
        if (Math.abs(dx) > 60) state.motion = dx > 0 ? "左扫" : "右扫";
        else if (Math.abs(dy) > 60) state.motion = dy > 0 ? "下扫" : "上扫";
        else if (Math.abs(dz) > 40) state.motion = dz > 0 ? "后推" : "前推";
        else state.motion = "静止";

        // 1.3 幅度 0-1
        state.amplitude = Math.min(Math.max((Math.abs(dx) + Math.abs(dy) + Math.abs(dz)) / 400, 0), 1);
        
        // 1.4 速度 (ms 停留 vs 连续帧速度)
        state.speed = dt; 

        applyMotionToRules();
    }
    updateStatusUI();
}

function applyGestureToShape(g) {
    const map = { "握拳": "sphere", "手掌": "torus", "剪刀手": "snowflake", "鹰爪": "spiral", "OK": "stardust" };
    if (g === "竖食指") {
        const keys = Object.keys(map);
        state.currentShape = map[keys[Math.floor(Math.random() * keys.length)]];
    } else if (map[g]) {
        state.currentShape = map[g];
    }
    targetPositions = generateShape(state.currentShape);
    document.getElementById('shape-select').value = (g === "竖食指") ? "random" : state.currentShape;
}

function applyMotionToRules() {
    // 3.2 运动方向 -> 运动模式
    if (state.motion.includes("扫")) {
        // 左右扫=拖尾，上下扫=向心/离心
        if (state.motion === "左扫" || state.motion === "右扫") state.motionMode = "trail";
        else state.motionMode = (Math.sin(Date.now() * 0.005) > 0) ? "in" : "out";
    } else if (state.motion.includes("推")) {
        state.motionMode = "explode"; // 前后推=爆炸
    } else {
        state.motionMode = "none";
    }
}

function updateStatusUI() {
    document.getElementById('current-gesture').innerText = state.gesture;
    document.getElementById('current-motion').innerText = state.motion;
    document.getElementById('amp-meter').style.width = (state.amplitude * 100) + "%";
    document.getElementById('amp-val').innerText = Math.round(state.amplitude * 100);
    document.getElementById('speed-meter').style.width = Math.min(state.speed / 4, 100) + "%";
    document.getElementById('speed-val').innerText = state.speed;
}

/** * 4. 动力学模拟 
 */
function animate() {
    requestAnimationFrame(animate);
    const time = clock.getElapsedTime();
    const positions = particles.geometry.attributes.position.array;
    const colors = particles.geometry.attributes.color.array;

    // 3.4 速度 -> 颜色 (慢冷 240-180H，快暖 0-60H)
    const isFast = state.speed > 200;
    let hue;
    if (state.colorMode === 'speed') {
        // 线性插值模拟
        const t = Math.min(state.amplitude * 2, 1);
        hue = isFast ? (0 + t * 60) : (240 - t * 60);
    } else if (state.colorMode === 'hsl') {
        hue = (time * 40) % 360;
    }

    const tempColor = new THREE.Color();
    
    for (let i = 0; i < state.particleCount; i++) {
        const idx = i * 3;
        
        // 平滑过渡到目标形状 (Morphing)
        positions[idx] += (targetPositions[idx] - positions[idx]) * 0.06;
        positions[idx+1] += (targetPositions[idx+1] - positions[idx+1]) * 0.06;
        positions[idx+2] += (targetPositions[idx+2] - positions[idx+2]) * 0.06;

        // 2.3 & 3.2 动态位移
        if (state.motionMode === 'explode') {
            const mag = 1 + state.amplitude * 0.05;
            positions[idx] *= mag;
            positions[idx+1] *= mag;
            positions[idx+2] *= mag;
        } else if (state.motionMode === 'in') {
            positions[idx] *= 0.98;
            positions[idx+1] *= 0.98;
            positions[idx+2] *= 0.98;
        } else if (state.motionMode === 'trail') {
            positions[idx] += Math.sin(time + i) * state.amplitude * 5;
        }

        // 颜色设置
        if (state.colorMode === 'picker') {
            const picked = new THREE.Color(document.getElementById('color-picker').value);
            colors[idx] = picked.r; colors[idx+1] = picked.g; colors[idx+2] = picked.b;
        } else {
            tempColor.setHSL(hue / 360, 0.8, 0.6);
            colors[idx] = tempColor.r; colors[idx+1] = tempColor.g; colors[idx+2] = tempColor.b;
        }
    }

    particles.geometry.attributes.position.needsUpdate = true;
    particles.geometry.attributes.color.needsUpdate = true;
    
    // 旋转背景
    particles.rotation.y += 0.001;

    renderer.render(scene, camera);
}

/** * UI 辅助 
 */
function toggleFullscreen() {
    if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
        document.getElementById('fullscreen-btn').innerText = "退出全屏";
    } else {
        document.exitFullscreen();
        document.getElementById('fullscreen-btn').innerText = "进入全屏";
    }
}

window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

document.getElementById('shape-select').onchange = (e) => {
    if(e.target.value === 'random') {
        applyGestureToShape("竖食指");
    } else {
        state.currentShape = e.target.value;
        targetPositions = generateShape(state.currentShape);
    }
};
document.getElementById('color-mode').onchange = (e) => state.colorMode = e.target.value;

// 启动
window.onload = () => {
    initThree();
    initHandPose();
    animate();
};

</script>
</body>
</html>
